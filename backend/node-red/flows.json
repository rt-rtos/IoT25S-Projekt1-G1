    {
        "id": "6f613c6a4e26d59d",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "chart points",
        "func": "// Live points. Series is the device id so several nodes share a chart.\n// Faulted channels are skipped rather than plotted as null.\nconst device = msg.topic.split(\"/\")[1];\nconst p = msg.payload;\nconst f = p.faults || {};\nconst now = Date.now();\nconst point = (v, fault) =>\n    fault ? null : { topic: device, payload: { x: now, y: v } };\n\nreturn [\n    point(p.t_in,    f.t_in),\n    point(p.rh_in,   f.rh_in),\n    point(p.t_out,   f.t_out),\n    point(p.t_water, f.t_water),\n];\n\nreturn msg;",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
