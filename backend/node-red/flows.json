    {
        "id": "d4d7b498969d62e7",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "row builder",
        "func": "// Row builder: MQTT telemetry -> params for the sqlite prepared statement.\n// Topic is microhydros/<device_id>/telemetry; the middle part is the device.\n// The node has no clock, so received_at is stamped here on ingest.\n\nconst parts = msg.topic.split(\"/\");\nconst p = msg.payload;\n\nif (parts.length < 3 || typeof p !== \"object\" || p === null) {\n    node.warn(\"dropped message with bad topic or payload: \" + msg.topic);\n    return null;\n}\n\nconst faults = p.faults || {};\n\nmsg.params = {\n    $received_at:   new Date().toISOString(),\n    $device_id:     parts[1],\n    $seq:           p.seq,\n    $uptime_s:      p.uptime_s,\n    $t_in:          p.t_in,\n    $rh_in:         p.rh_in,\n    $t_out:         p.t_out,\n    $t_water:       p.t_water,\n    $fault_t_in:    faults.t_in,\n    $fault_rh_in:   faults.rh_in,\n    $fault_t_out:   faults.t_out,\n    $fault_t_water: faults.t_water,\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 340,
        "wires": [
            [
                "757169275005d7b2",
                "5452e4cbcbbc654f"
            ]
        ]
    },
    {
        "id": "757169275005d7b2",
        "type": "sqlite",
        "z": "f6f2187d.f17ca8",
        "mydb": "0bba1715d78313ac",
        "sqlquery": "prepared",
        "sql": "INSERT INTO telemetry (received_at, device_id, seq, uptime_s,\n                       t_in, rh_in, t_out, t_water,\n                       fault_t_in, fault_rh_in, fault_t_out, fault_t_water)\nVALUES ($received_at, $device_id, $seq, $uptime_s,\n        $t_in, $rh_in, $t_out, $t_water,\n        $fault_t_in, $fault_rh_in, $fault_t_out, $fault_t_water);\n",
        "name": "insert telemetry",
        "x": 460,
        "y": 340,
        "wires": [
            []
        ]
    },
    {
